# =============================================================================
# Social analytics OAuth — Chris + Stephen (2 accounts per platform each)
# Copy to scripts/.env on each machine. NEVER commit scripts/.env.
# Settings → Publishing setup shows what's missing.
# =============================================================================

# Who owns connects on THIS machine (stephen | chris)
# Stephen: PUBLISHING_OWNER=stephen
# Chris:   PUBLISHING_OWNER=chris  (default if unset)
# PUBLISHING_OWNER=chris

# OAuth returns here after connect — register EXACTLY this in Google, TikTok, Meta:
# PUBLISHING_OAUTH_REDIRECT_BASE=http://localhost:3000
# → redirect URI: http://localhost:3000/accounts/callback

# Do NOT use mock for real analytics:
# DISCOVERY_PUBLISH_PROVIDER=mock
# DISCOVERY_PUBLISH_DRY_RUN=1

# --- YouTube (Google Cloud → APIs → YouTube Data API v3 → OAuth client) ---
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=http://localhost:3000/accounts/callback

# --- TikTok (developers.tiktok.com → Login Kit) ---
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=http://localhost:3000/accounts/callback

# --- Instagram + Facebook (developers.facebook.com → one Meta app) ---
# META_APP_ID=
# META_APP_SECRET=

# Videos → Link post + library edits (same value in web/.env.local)
# AI_VIDEO_INTERNAL_KEY=your-local-secret

# Auto-refresh linked post analytics while API runs (default on, 6 hours)
# ANALYTICS_AUTO_REFRESH=1
# ANALYTICS_AUTO_REFRESH_MINUTES=360

# =============================================================================
# Brother sync (see .cursor/skills/brother-sync/SKILL.md)
# =============================================================================
# Stephen only:
# SHARED_LIBRARY_EXPORT_OWNER=stephen
# SHARED_LIBRARY_AUTO_SYNC=1
# SHARED_LIBRARY_AUTO_SYNC_MINUTES=10
# BROTHER_AUTO_PULL=1
# BROTHER_SYNC_MINUTES=10
# Deletions in library/Videos tab sync via shared_library/deletions.json (Git)

# Optional — YouTube Data API trending (NOT the same as OAuth above)
# YOUTUBE_API_KEY=

# Optional — GPT story generation
# OPENAI_API_KEY=

# Real python.exe for API, weekly 7am, montage workers (not empty Windows Store alias)
# AI_VIDEO_PYTHON=C:\Users\you\AppData\Local\Programs\Python\Python313\python.exe

# Optional — FFmpeg path if not on system PATH
# FFMPEG_DIR=C:\Program Files\Streamlabs OBS\resources\app.asar.unpacked\node_modules\obs-studio-node
