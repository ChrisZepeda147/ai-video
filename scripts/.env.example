# Stephen shared library — auto pull+import his video packages (default on, every 10 min).
# SHARED_LIBRARY_AUTO_SYNC=1
# SHARED_LIBRARY_AUTO_SYNC_MINUTES=10
# Stephen only — auto-export finished jobs to shared_library/stephen/ on register:
# SHARED_LIBRARY_EXPORT_OWNER=stephen

# Optional — directory with ffmpeg.exe + ffprobe.exe for yt-dlp postprocess (not on system PATH).
# This machine: Streamlabs OBS bundle:
# FFMPEG_DIR=C:\Program Files\Streamlabs OBS\resources\app.asar.unpacked\node_modules\obs-studio-node
# Caption burn (libass) uses imageio-ffmpeg from pip (requirements-youtube.txt) automatically.

# Optional — enables YouTube Data API trending with category filters.
YOUTUBE_API_KEY=

# Optional — enables GPT story generation (otherwise a template is used).
OPENAI_API_KEY=

# TikTok Content Posting API (official). Create an app at developers.tiktok.com,
# enable Content Posting, and register this redirect URI on the app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8787/callback
